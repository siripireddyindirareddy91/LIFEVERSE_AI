APP_ENV=development
DATABASE_URL=postgresql+psycopg://lifeverse:lifeverse_local@localhost:5432/lifeverse
# Dedicated non-owner runtime role; migrations use DATABASE_URL above.
RUNTIME_DATABASE_URL=postgresql+psycopg://lifeverse_app:lifeverse_app_local@localhost:5432/lifeverse
SUPABASE_URL=
CORS_ORIGINS=["http://localhost:3000"]
# Server-side only. Never put AI credentials in mobile config.
AI_API_KEY=
AI_MODEL=
AI_REQUESTS_PER_DAY=50
AI_REQUESTS_PER_MINUTE=5
CONVERSATION_RETENTION_DAYS=7
LANGSMITH_TRACING=false
DISPATCH_DATABASE_URL=postgresql+psycopg://lifeverse_dispatcher:dispatcher_local@localhost:5432/lifeverse
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1536
AGENT_MAX_MODEL_CALLS=10
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_PROPOSALS=8
AGENT_RUNS_PER_DAY=10
AGENT_RUN_TIMEOUT_SECONDS=240
AGENT_APPROVAL_MINUTES=60
AGENT_HISTORY_DAYS=30

# Server-side AES-256 keys, base64-encoded; keep old key IDs during rotation.
VAULT_ENCRYPTION_KEYS={}
VAULT_ACTIVE_KEY_ID=v1

# Calendar server-side OAuth registration. HTTPS origin, no trailing path.
OAUTH_PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
EXTERNAL_APIS_ENABLED=false
WORKFLOW_RUNS_PER_DAY=40
